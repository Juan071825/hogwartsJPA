<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="default">
        <class>hogwarts.entities.Course</class>
        <class>hogwarts.entities.Enrollment</class>
        <class>hogwarts.entities.EnrollmentId</class>
        <class>hogwarts.entities.House</class>
        <class>hogwarts.entities.HousePoint</class>
        <class>hogwarts.entities.Person</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://127.0.0.1:3310/bbdd_hogwarts"/>
            <property name="jakarta.persistence.jdbc.user" value="hog"/>
            <property name="jakarta.persistence.jdbc.password" value="1234"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>


    </persistence-unit>
</persistence>
